rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function isTripMember() {
      return signedIn() && email() in resource.data.members;
    }

    function willBeTripMember() {
      return signedIn() && email() in request.resource.data.members;
    }

    function isTripOwner() {
      return signedIn() && resource.data.owner == email();
    }

    function keepsOwner() {
      return request.resource.data.owner == resource.data.owner
        && resource.data.owner in request.resource.data.members;
    }

    function keepsMembers() {
      return request.resource.data.members == resource.data.members;
    }

    function ownerUpdatesMembers() {
      return isTripOwner()
        && resource.data.owner in request.resource.data.members;
    }

    function isValidNewTrip() {
      return request.resource.data.owner is string
        && request.resource.data.members is list
        && request.resource.data.title is string
        && request.resource.data.destination is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.days is list
        && request.resource.data.members.size() == 1;
    }

    function isJoiningSelf() {
      return signedIn()
        && !(email() in resource.data.members)
        && email() in request.resource.data.members
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow read: if isTripMember();
      allow create: if willBeTripMember()
        && request.resource.data.owner == email()
        && isValidNewTrip();
      allow update: if isJoiningSelf()
        || (isTripMember()
          && willBeTripMember()
          && keepsOwner()
          && (keepsMembers() || ownerUpdatesMembers()));
      allow delete: if signedIn() && resource.data.owner == email();
    }
  }
}
